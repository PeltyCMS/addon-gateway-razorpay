{
  "id": "gateway-razorpay",
  "name": "Razorpay",
  "version": "0.1.0",
  "kind": "gateway",
  "engine": "wasm",
  "provides": "razorpay",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.gateway.razorpay",
  "author": "MythicalSystems",
